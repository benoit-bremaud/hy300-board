# Raw firmware / flash dumps: large and possibly containing device-specific
# secrets (keys, MAC addresses). Track their SHA-256 in dumps/README.md instead.
dumps/*
!dumps/README.md

# Large photos and captures
*.raw
*.img
*.bin
*.pcap
*.pcapng

# Environment and editor
.env
.env.*
.DS_Store

# Full teardown photo set (196 MB, 2026-11-05): kept locally, only the
# curated photos in photos/ are tracked
photos/raw/
